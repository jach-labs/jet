.venv/
__pycache__/
/data/*
# Held-out sets are versioned: model comparisons only mean something on identical rows.
!/data/val.jsonl
!/data/test.jsonl
!/data/score_eval.jsonl
# Current training set, so any machine can train without rebuilding it.
!/data/train_v2.jsonl
/adapters/
/models/
*.egg-info/
.DS_Store
/logs/

# Large local quantization builds; reports are kept under docs/bench.
/artifacts/quantization/
/artifacts/decision-index/

# Release export intermediates and local logs.
/artifacts/release-*/
/release-logs/
# Local model exports and reconstructed training/benchmark rows.
/releases/**/*.safetensors
/releases/**/tokenizer.json
/experiments/**/*.jsonl
/experiments/**/status.json
/experiments/**/*-status.json
/experiments/**/*-logits.json
.venv-*/
# Copied from src/ by the release scripts.
/releases/*/format.py
/releases/*/inference.py
